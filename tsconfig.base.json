{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    // Node-compatible ESM resolution for declarations, source tests, and CLI
    // compilation. Core JavaScript is bundled separately by Bun for Node.
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2023",
    "lib": ["es2023"],
    "paths": {
      "searchgres": ["./packages/core/src/index.ts"]
    },

    // Source imports name the real file (`./foo.ts`); TypeScript rewrites the
    // specifier to `./foo.js` when emitting declarations/CLI JavaScript. Node
    // source tests and Bun can resolve the original files directly.
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,

    // Type-only imports must say so, so emit never depends on type resolution.
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    // Strictness. `noUncheckedIndexedAccess` in particular: it types `arr[0]` as
    // `T | undefined`, which catches a whole class of real bugs.
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,

    // Third-party .d.ts files are not our problem to typecheck.
    "skipLibCheck": true
  }
}

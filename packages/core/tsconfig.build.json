{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "emitDeclarationOnly": true,
    // Members tagged `@internal` (Index.sql, the Index constructor) are
    // implementation plumbing, not API; keep them out of the published types.
    "stripInternal": true,
    // Bun emits the JavaScript bundle and linked map with embedded sources.
    // Declaration maps cannot inline sources and would dangle in the tarball.
    "declarationMap": false,
    "tsBuildInfoFile": "tsconfig.build.tsbuildinfo"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts", "src/test/**"]
}
